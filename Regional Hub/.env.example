# National Cleft Registry - Regional Hub configuration
#
# You normally do NOT edit this by hand: run  node setup-env.mjs  (the start
# scripts do this automatically) and it will create .env with fresh random
# secrets. KEEP A SAFE COPY OF .env - without DB_ENCRYPTION_KEY the database
# cannot be opened.

# Encrypts the whole SQLite database file at rest (64 hex chars).
DB_ENCRYPTION_KEY=replace-with-a-random-64-char-hex-string

# Encrypts the Main Hub sync API key stored in the database (64 hex chars).
ENCRYPTION_KEY=replace-with-a-random-64-char-hex-string

# Signs CSRF tokens (64 hex chars).
CSRF_SECRET=replace-with-a-random-64-char-hex-string

# SQLite database location. The start scripts set an absolute path automatically.
DATABASE_URL=file:local.db

# Optional default for the Main Hub address (can also be set on the Sync page).
# Use https:// when the Main Hub is reached over the internet.
# MAIN_HUB_URL=https://ncr-main.example.gov.gh

# Optional: minutes between automatic background syncs (default 5).
# SYNC_INTERVAL_MINUTES=5

# Optional: force the Secure cookie flag (set true once served over HTTPS).
# COOKIE_SECURE=true
