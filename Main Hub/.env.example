# SQLite database file. The start.bat/start.sh launcher scripts automatically
# override this with an absolute path based on wherever you've placed this
# folder, so you normally don't need to edit this line yourself. It's only
# used as a fallback if you run "node server.js" directly without the launcher.
DATABASE_URL=file:main_hub.db

# Random secrets used for session/CSRF signing — replace with your own in production
SESSION_SECRET=replace-with-a-random-64-char-hex-string
CSRF_SECRET=replace-with-a-different-random-64-char-hex-string

NODE_ENV=development
