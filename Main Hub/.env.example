# National Cleft Registry - Main Hub configuration
#
# You normally do NOT edit this by hand: run  node setup-env.mjs  (the start
# scripts do this automatically) and it will create .env with fresh random
# secrets. KEEP A SAFE COPY OF .env - without DB_ENCRYPTION_KEY the database
# cannot be opened.

# Encrypts the whole SQLite database file at rest (64 hex chars).
DB_ENCRYPTION_KEY=replace-with-a-random-64-char-hex-string

# Signs CSRF tokens (64 hex chars).
CSRF_SECRET=replace-with-a-random-64-char-hex-string

# SQLite database location. The start scripts set an absolute path automatically.
DATABASE_URL=file:main_hub.db

# Optional: force the Secure cookie flag. Leave unset to follow the request
# protocol (HTTPS => secure). Set to true once the hub is served over HTTPS.
# COOKIE_SECURE=true

# Optional: how long a login lasts (hours).
# SESSION_TTL_HOURS=12
